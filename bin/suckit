#!/usr/bin/env bash
# suckit — pull in skills and commands from ~/.claude into this repo.
#
# Source: ~/.claude/skills/    -> <repo>/skills/
#         ~/.claude/commands/  -> <repo>/commands/
#         ~/.claude/hooks/     -> <repo>/hooks/
#
# New entries are copied in. Existing entries are diffed against their
# ~/.claude source and, when they differ, the repo copy is updated to match
# the source. Identical entries are left untouched.

set -euo pipefail

# Resolve the repo root as the parent of this script's directory, so the
# script works regardless of the caller's cwd.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

src_skills="$HOME/.claude/skills"
src_commands="$HOME/.claude/commands"
src_hooks="$HOME/.claude/hooks"
dst_skills="$repo_root/skills"
dst_commands="$repo_root/commands"
dst_hooks="$repo_root/hooks"

added_skills=()
updated_skills=()
added_commands=()
updated_commands=()
added_hooks=()
updated_hooks=()
skipped=0

# Sync top-level entries from $1 (source) into $2 (destination), labeling
# output with $3 (skill|command|hook), appending newly-added names to the
# global array named by $4 and updated names to the array named by $5.
# Entries that already match their source are left untouched.
sync_dir() {
    src="$1"
    dst="$2"
    label="$3"
    added_name="$4"
    updated_name="$5"

    if [[ ! -d "$src" ]]; then
        printf '  (no source dir %s — skipping)\n' "$src"
        return 0
    fi

    mkdir -p "$dst"

    # nullglob: empty dir yields no iterations instead of a literal '*'.
    # dotglob is left off so .DS_Store and friends are never copied.
    shopt -s nullglob
    for entry in "$src"/*; do
        name="$(basename "$entry")"

        if [[ -e "$dst/$name" ]]; then
            # diff -rq handles both files and directory trees, ignoring
            # nothing but reporting only whether they differ.
            if diff -rq "$entry" "$dst/$name" >/dev/null 2>&1; then
                skipped=$((skipped + 1))
                continue
            fi

            # Diverged: replace the repo copy wholesale with the source so
            # deletions inside the source are reflected too.
            rm -rf "$dst/$name"
            cp -R "$entry" "$dst/"
            eval "${updated_name}+=(\"\$name\")"
            printf '  ~ %s: %s (updated)\n' "$label" "$name"
            continue
        fi

        cp -R "$entry" "$dst/"
        # Append to the caller-named global array via eval — Bash 3.2 has
        # no namerefs, so this is the portable equivalent.
        eval "${added_name}+=(\"\$name\")"
        printf '  + %s: %s\n' "$label" "$name"
    done
    shopt -u nullglob
}

printf 'syncing skills from %s -> %s\n' "$src_skills" "$dst_skills"
sync_dir "$src_skills" "$dst_skills" skill added_skills updated_skills

printf '\nsyncing commands from %s -> %s\n' "$src_commands" "$dst_commands"
sync_dir "$src_commands" "$dst_commands" command added_commands updated_commands

printf '\nsyncing hooks from %s -> %s\n' "$src_hooks" "$dst_hooks"
sync_dir "$src_hooks" "$dst_hooks" hook added_hooks updated_hooks

printf '\n---\n'
printf 'added %d skill(s), %d command(s), %d hook(s); updated %d; skipped %d unchanged entr%s.\n' \
    "${#added_skills[@]}" "${#added_commands[@]}" "${#added_hooks[@]}" \
    "$(( ${#updated_skills[@]} + ${#updated_commands[@]} + ${#updated_hooks[@]} ))" \
    "$skipped" \
    "$([[ $skipped -eq 1 ]] && echo y || echo ies)"

if (( ${#added_skills[@]} > 0 )); then
    printf '\nReminder: add each new skill to README.md under "## Skills"\n'
    printf '          using the skill name and its frontmatter description.\n'
    printf 'New skills:\n'
    printf '  - %s\n' "${added_skills[@]}"
fi
